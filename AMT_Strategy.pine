//@version=5
strategy("Auction Market Theory Strategy v1.0",
         shorttitle="AMT Strategy",
         overlay=true,
         initial_capital=10000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=10,
         commission_type=strategy.commission.percent,
         commission_value=0.1,
         slippage=2)

// ============================================================================
// AUCTION MARKET THEORY STRATEGY
// ============================================================================
// Based on Volume Profile and Market Microstructure principles
// - Value Area (70% volume range)
// - Point of Control (highest volume price)
// - Acceptance/Rejection patterns
// - Rotation vs Trend market types
// ============================================================================

// ===================
// INPUTS
// ===================

// Volume Profile Settings
lookback_period = input.int(20, "Profile Lookback Period (Bars)", minval=10, maxval=100, tooltip="Number of bars to calculate volume profile")
value_area_pct = input.float(70.0, "Value Area Percentage", minval=60.0, maxval=80.0, step=1.0, tooltip="Percentage of volume contained in Value Area (typically 70%)")
profile_rows = input.int(24, "Profile Resolution (Rows)", minval=12, maxval=48, tooltip="Number of price levels in volume profile")

// Entry Settings
acceptance_bars = input.int(3, "Acceptance Bars", minval=2, maxval=10, tooltip="Bars needed above/below level for acceptance")
volume_multiplier = input.float(1.2, "Volume Confirmation", minval=1.0, maxval=2.0, step=0.1, tooltip="Volume must be X times average for breakout confirmation")
use_mean_reversion = input.bool(true, "Enable Mean Reversion Trades", tooltip="Trade returns to POC from extremes")
use_breakout = input.bool(true, "Enable Breakout Trades", tooltip="Trade acceptance above VAH / below VAL")

// Risk Management
stop_loss_pct = input.float(2.0, "Stop Loss (%)", minval=0.5, maxval=5.0, step=0.5)
take_profit_pct = input.float(4.0, "Take Profit (%)", minval=1.0, maxval=10.0, step=0.5)
use_poc_exit = input.bool(true, "Exit at POC", tooltip="Close mean reversion trades when POC is reached")

// ===================
// VOLUME PROFILE CALCULATION
// ===================

// Calculate price range for profile
calc_profile() =>
    var float[] price_levels = array.new_float(profile_rows)
    var float[] volume_levels = array.new_float(profile_rows)

    // Find high/low over lookback period
    highest_price = ta.highest(high, lookback_period)
    lowest_price = ta.lowest(low, lookback_period)
    price_range = highest_price - lowest_price

    // Avoid division by zero
    if price_range <= 0
        price_range := 1.0

    row_size = price_range / profile_rows

    // Initialize arrays
    for i = 0 to profile_rows - 1
        array.set(price_levels, i, lowest_price + (i * row_size))
        array.set(volume_levels, i, 0.0)

    // Accumulate volume in each price level
    for i = 0 to math.min(lookback_period - 1, bar_index - 1)
        bar_high = high[i]
        bar_low = low[i]
        bar_volume = volume[i]
        bar_range = bar_high - bar_low

        if bar_range > 0
            // Distribute volume across touched price levels
            for j = 0 to profile_rows - 1
                level_price = array.get(price_levels, j)
                level_top = level_price + row_size

                // Check if this bar touched this price level
                if bar_high >= level_price and bar_low <= level_top
                    // Calculate overlap percentage
                    overlap_low = math.max(bar_low, level_price)
                    overlap_high = math.min(bar_high, level_top)
                    overlap = overlap_high - overlap_low
                    volume_contribution = bar_volume * (overlap / bar_range)

                    current_vol = array.get(volume_levels, j)
                    array.set(volume_levels, j, current_vol + volume_contribution)
        else
            // Bar has no range, assign all volume to closest level
            closest_idx = math.round((bar_low - lowest_price) / row_size)
            closest_idx := math.max(0, math.min(profile_rows - 1, closest_idx))
            current_vol = array.get(volume_levels, closest_idx)
            array.set(volume_levels, closest_idx, current_vol + bar_volume)

    [price_levels, volume_levels, lowest_price, highest_price, row_size]

// Find Point of Control (POC) - price with highest volume
find_poc(volume_levels, price_levels) =>
    max_volume = 0.0
    poc_idx = 0

    for i = 0 to array.size(volume_levels) - 1
        vol = array.get(volume_levels, i)
        if vol > max_volume
            max_volume := vol
            poc_idx := i

    poc_price = array.get(price_levels, poc_idx)
    [poc_price, poc_idx, max_volume]

// Calculate Value Area (70% of volume around POC)
find_value_area(volume_levels, price_levels, poc_idx, value_pct) =>
    total_volume = 0.0
    for i = 0 to array.size(volume_levels) - 1
        total_volume := total_volume + array.get(volume_levels, i)

    target_volume = total_volume * (value_pct / 100.0)

    // Expand from POC until we capture target_volume
    va_volume = array.get(volume_levels, poc_idx)
    va_high_idx = poc_idx
    va_low_idx = poc_idx

    while va_volume < target_volume and (va_high_idx < array.size(volume_levels) - 1 or va_low_idx > 0)
        // Check volume above and below
        vol_above = va_high_idx < array.size(volume_levels) - 1 ? array.get(volume_levels, va_high_idx + 1) : 0.0
        vol_below = va_low_idx > 0 ? array.get(volume_levels, va_low_idx - 1) : 0.0

        // Expand towards higher volume
        if vol_above > vol_below and va_high_idx < array.size(volume_levels) - 1
            va_high_idx := va_high_idx + 1
            va_volume := va_volume + vol_above
        else if va_low_idx > 0
            va_low_idx := va_low_idx - 1
            va_volume := va_volume + vol_below
        else if va_high_idx < array.size(volume_levels) - 1
            va_high_idx := va_high_idx + 1
            va_volume := va_volume + vol_above
        else
            break

    vah = array.get(price_levels, va_high_idx)
    val = array.get(price_levels, va_low_idx)

    [vah, val]

// ===================
// CALCULATE AMT LEVELS
// ===================

[price_levels, volume_levels, profile_low, profile_high, row_size] = calc_profile()
[poc, poc_idx, poc_volume] = find_poc(volume_levels, price_levels)
[vah, val] = find_value_area(volume_levels, price_levels, poc_idx, value_area_pct)

// ===================
// MARKET CONTEXT
// ===================

// Determine if market is in rotation (balanced) or trending (imbalanced)
price_in_value = close >= val and close <= vah
price_above_value = close > vah
price_below_value = close < val

// Distance from POC as percentage
dist_from_poc = math.abs(close - poc) / poc * 100

// Market type based on recent behavior
bars_in_value = 0
bars_above_value = 0
bars_below_value = 0

for i = 0 to math.min(lookback_period - 1, bar_index - 1)
    if close[i] >= val and close[i] <= vah
        bars_in_value := bars_in_value + 1
    else if close[i] > vah
        bars_above_value := bars_above_value + 1
    else
        bars_below_value := bars_below_value + 1

total_bars = bars_in_value + bars_above_value + bars_below_value
rotation_pct = total_bars > 0 ? (bars_in_value / total_bars) * 100 : 0

market_type = rotation_pct > 60 ? "ROTATING" : bars_above_value > bars_below_value ? "TRENDING UP" : "TRENDING DOWN"

// Volume confirmation
vol_ma = ta.sma(volume, 20)
high_volume = volume > vol_ma * volume_multiplier

// ===================
// ACCEPTANCE / REJECTION DETECTION
// ===================

// Count consecutive bars above/below key levels
var int bars_above_vah = 0
var int bars_below_val = 0

if close > vah
    bars_above_vah := bars_above_vah + 1
    bars_below_val := 0
else if close < val
    bars_below_val := bars_below_val + 1
    bars_above_vah := 0
else
    bars_above_vah := 0
    bars_below_val := 0

// Acceptance confirmed
acceptance_above_vah = bars_above_vah >= acceptance_bars
acceptance_below_val = bars_below_val >= acceptance_bars

// Mean reversion conditions
approaching_poc_from_below = close < poc and close > val and close[1] < close
approaching_poc_from_above = close > poc and close < vah and close[1] > close
extended_from_poc = dist_from_poc > 3.0  // More than 3% from fair value

// ===================
// ENTRY SIGNALS
// ===================

// BREAKOUT SIGNALS: Acceptance outside Value Area
long_breakout = use_breakout and acceptance_above_vah and high_volume and market_type != "TRENDING DOWN"
short_breakout = use_breakout and acceptance_below_val and high_volume and market_type != "TRENDING UP"

// MEAN REVERSION SIGNALS: Return to POC from extremes
long_mean_reversion = use_mean_reversion and price_below_value and approaching_poc_from_below and extended_from_poc
short_mean_reversion = use_mean_reversion and price_above_value and approaching_poc_from_above and extended_from_poc

// Combined signals
long_signal = long_breakout or long_mean_reversion
short_signal = short_breakout or short_mean_reversion

// Track entry type
var string entry_type = ""

if long_signal
    entry_type := long_breakout ? "BREAKOUT" : "MEAN_REV"
if short_signal
    entry_type := short_breakout ? "BREAKOUT" : "MEAN_REV"

// ===================
// POSITION MANAGEMENT
// ===================

// Calculate stop loss and take profit
long_stop = close * (1 - stop_loss_pct / 100)
long_target = close * (1 + take_profit_pct / 100)
short_stop = close * (1 + stop_loss_pct / 100)
short_target = close * (1 - take_profit_pct / 100)

// Exit conditions
at_poc = math.abs(close - poc) / poc < 0.005  // Within 0.5% of POC
poc_exit_condition = use_poc_exit and at_poc and entry_type == "MEAN_REV"

// ===================
// EXECUTE TRADES
// ===================

// Entry
if long_signal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if short_signal and strategy.position_size == 0
    strategy.entry("Short", strategy.short)

// Exits
if strategy.position_size > 0  // Long position
    strategy.exit("Long Exit", "Long", stop=long_stop, limit=long_target)
    if poc_exit_condition
        strategy.close("Long", comment="POC Reached")

if strategy.position_size < 0  // Short position
    strategy.exit("Short Exit", "Short", stop=short_stop, limit=short_target)
    if poc_exit_condition
        strategy.close("Short", comment="POC Reached")

// ===================
// VISUALIZATION
// ===================

// Plot AMT levels
plot(vah, "VAH", color=color.new(color.red, 0), linewidth=2, style=plot.style_line)
plot(poc, "POC", color=color.new(color.yellow, 0), linewidth=3, style=plot.style_line)
plot(val, "VAL", color=color.new(color.green, 0), linewidth=2, style=plot.style_line)

// Fill Value Area
vah_plot = plot(vah, color=na)
val_plot = plot(val, color=na)
fill(vah_plot, val_plot, color=color.new(color.blue, 90), title="Value Area")

// Background color based on market type
bgcolor(price_above_value ? color.new(color.green, 95) : price_below_value ? color.new(color.red, 95) : color.new(color.blue, 97))

// ===================
// INFO TABLE
// ===================

var table info_table = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 85), border_width=1)

if barstate.islast
    // Header
    table.cell(info_table, 0, 0, "AMT LEVELS", text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.small)
    table.cell(info_table, 1, 0, "VALUE", text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.small)

    // AMT Levels
    table.cell(info_table, 0, 1, "VAH", text_color=color.red, text_size=size.small)
    table.cell(info_table, 1, 1, str.tostring(vah, format.mintick), text_color=color.white, text_size=size.small)

    table.cell(info_table, 0, 2, "POC", text_color=color.yellow, text_size=size.small)
    table.cell(info_table, 1, 2, str.tostring(poc, format.mintick), text_color=color.white, text_size=size.small)

    table.cell(info_table, 0, 3, "VAL", text_color=color.green, text_size=size.small)
    table.cell(info_table, 1, 3, str.tostring(val, format.mintick), text_color=color.white, text_size=size.small)

    // Market Context
    table.cell(info_table, 0, 4, "────────", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 4, "────────", text_color=color.gray, text_size=size.small)

    table.cell(info_table, 0, 5, "Market Type", text_color=color.white, text_size=size.small)
    market_color = market_type == "ROTATING" ? color.blue : market_type == "TRENDING UP" ? color.green : color.red
    table.cell(info_table, 1, 5, market_type, text_color=market_color, text_size=size.small)

    table.cell(info_table, 0, 6, "Price Position", text_color=color.white, text_size=size.small)
    position_text = price_above_value ? "Above VA" : price_below_value ? "Below VA" : "In VA"
    position_color = price_above_value ? color.green : price_below_value ? color.red : color.blue
    table.cell(info_table, 1, 6, position_text, text_color=position_color, text_size=size.small)

    table.cell(info_table, 0, 7, "Dist from POC", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 7, str.tostring(dist_from_poc, "#.##") + "%", text_color=color.white, text_size=size.small)

    table.cell(info_table, 0, 8, "Rotation %", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 8, str.tostring(rotation_pct, "#.#") + "%", text_color=color.white, text_size=size.small)

    table.cell(info_table, 0, 9, "Volume", text_color=color.white, text_size=size.small)
    vol_color = high_volume ? color.green : color.gray
    vol_text = high_volume ? "HIGH" : "NORMAL"
    table.cell(info_table, 1, 9, vol_text, text_color=vol_color, text_size=size.small)

// ===================
// ALERTS
// ===================

alertcondition(long_signal, title="AMT Long Signal", message="AMT: Long signal - {{ticker}} @ {{close}}")
alertcondition(short_signal, title="AMT Short Signal", message="AMT: Short signal - {{ticker}} @ {{close}}")
alertcondition(at_poc, title="AMT At POC", message="AMT: Price reached POC - {{ticker}} @ {{close}}")
