//@version=5
strategy("Trend + Momentum + Volume Strategy", overlay=true,
         initial_capital=10000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=100,
         commission_type=strategy.commission.percent,
         commission_value=0.1,
         slippage=2)

// ============================================
// PARAMETERS
// ============================================

// Trend Parameters
fast_ema = input.int(20, "Fast EMA", minval=5, maxval=50)
slow_ema = input.int(50, "Slow EMA", minval=20, maxval=200)
trend_filter = input.bool(true, "Use 200 EMA Filter", tooltip="Only long when price > 200 EMA")

// Momentum Parameters
rsi_period = input.int(14, "RSI Period", minval=5, maxval=30)
rsi_oversold = input.int(40, "RSI Oversold", minval=20, maxval=50)
rsi_overbought = input.int(60, "RSI Overbought", minval=50, maxval=80)

// Volume Parameters
volume_ma_period = input.int(20, "Volume MA Period", minval=10, maxval=50)
volume_multiplier = input.float(1.2, "Volume Multiplier", minval=1.0, maxval=3.0, step=0.1)

// Risk Management
use_stops = input.bool(true, "Enable Stop Loss/Take Profit")
stop_loss_pct = input.float(2.0, "Stop Loss %", minval=0.5, maxval=10.0, step=0.5)
take_profit_pct = input.float(4.0, "Take Profit %", minval=1.0, maxval=20.0, step=0.5)
use_trailing = input.bool(true, "Use Trailing Stop")
trailing_pct = input.float(1.5, "Trailing Stop %", minval=0.5, maxval=5.0, step=0.5)

// Position Sizing
fixed_position = input.float(10.0, "Position Size %", minval=5.0, maxval=50.0, step=5.0)

// ============================================
// INDICATORS
// ============================================

// EMAs
ema_fast = ta.ema(close, fast_ema)
ema_slow = ta.ema(close, slow_ema)
ema_200 = ta.ema(close, 200)

// RSI
rsi = ta.rsi(close, rsi_period)

// MACD
[macd_line, signal_line, macd_hist] = ta.macd(close, 12, 26, 9)

// Volume
vol_ma = ta.sma(volume, volume_ma_period)
volume_strong = volume > vol_ma * volume_multiplier

// ATR for volatility
atr = ta.atr(14)

// ============================================
// SIGNAL LOGIC - SIMPLE AND CLEAR
// ============================================

// TREND: Fast EMA crosses above Slow EMA
trend_bullish = ema_fast > ema_slow
trend_crossover = ta.crossover(ema_fast, ema_slow)

// 200 EMA Filter (optional)
above_200 = trend_filter ? close > ema_200 : true

// MOMENTUM: RSI and MACD aligned
momentum_bullish = rsi > rsi_oversold and rsi < rsi_overbought
macd_bullish = macd_line > signal_line and macd_hist > 0

// VOLUME: Strong volume confirms breakout
volume_confirms = volume_strong

// ============================================
// ENTRY CONDITIONS
// ============================================

// LONG Entry: All 3 elements aligned
long_entry = trend_crossover and momentum_bullish and macd_bullish and above_200 and volume_confirms

// No open position
no_position = strategy.position_size == 0

// Final long signal
long_signal = long_entry and no_position

// ============================================
// EXIT CONDITIONS
// ============================================

// Exit on trend reversal
trend_bearish = ta.crossunder(ema_fast, ema_slow)
exit_trend = trend_bearish

// Exit on momentum exhaustion
momentum_exhausted = rsi > rsi_overbought or macd_line < signal_line
exit_momentum = momentum_exhausted

// Combined exit (but stops take priority)
should_exit = exit_trend or exit_momentum

// ============================================
// EXECUTE TRADES
// ============================================

if long_signal
    strategy.entry("Long", strategy.long, qty=fixed_position)

    if use_stops
        stop_price = close * (1 - stop_loss_pct / 100)
        take_price = close * (1 + take_profit_pct / 100)

        if use_trailing
            strategy.exit("Exit", "Long",
                         stop=stop_price,
                         limit=take_price,
                         trail_offset=close * trailing_pct / 100)
        else
            strategy.exit("Exit", "Long", stop=stop_price, limit=take_price)

// Manual exit on signal reversal
if should_exit and strategy.position_size > 0
    strategy.close("Long", comment="Signal Exit")

// ============================================
// VISUALIZATION
// ============================================

// Plot EMAs
plot(ema_fast, "Fast EMA", color=color.new(color.blue, 0), linewidth=2)
plot(ema_slow, "Slow EMA", color=color.new(color.orange, 0), linewidth=2)
plot(ema_200, "200 EMA", color=color.new(color.gray, 0), linewidth=1)

// Plot signals
plotshape(long_signal, "Long", shape.triangleup, location.belowbar, color.green, size=size.normal)
plotshape(exit_trend, "Exit", shape.triangledown, location.abovebar, color.red, size=size.small)

// Background color for trend
bgcolor(trend_bullish ? color.new(color.green, 95) : color.new(color.red, 95))

// ============================================
// INFO TABLE
// ============================================

var table info_table = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 85), border_width=1)

if barstate.islast
    // Signals
    table.cell(info_table, 0, 0, "SIGNALS", text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.small)
    table.cell(info_table, 1, 0, "STATUS", text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.small)

    table.cell(info_table, 0, 1, "Trend", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 1, trend_bullish ? "BULL" : "BEAR",
               text_color=trend_bullish ? color.lime : color.red, text_size=size.small)

    table.cell(info_table, 0, 2, "RSI", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 2, str.tostring(rsi, "#"),
               text_color=rsi > 50 ? color.lime : color.red, text_size=size.small)

    table.cell(info_table, 0, 3, "MACD", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 3, macd_bullish ? "BULL" : "BEAR",
               text_color=macd_bullish ? color.lime : color.red, text_size=size.small)

    table.cell(info_table, 0, 4, "Volume", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 4, volume_confirms ? "HIGH" : "LOW",
               text_color=volume_confirms ? color.lime : color.orange, text_size=size.small)

    // Performance
    table.cell(info_table, 0, 5, "═══════", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 5, "═══════", text_color=color.gray, text_size=size.small)

    net_profit = strategy.netprofit
    num_trades = strategy.closedtrades
    win_rate = num_trades > 0 ? strategy.wintrades / num_trades * 100 : 0

    table.cell(info_table, 0, 6, "P&L", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 6, str.tostring(net_profit, "#"),
               text_color=net_profit > 0 ? color.lime : color.red, text_size=size.small)

    table.cell(info_table, 0, 7, "WR / Trades", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 7, str.tostring(win_rate, "#") + "% / " + str.tostring(num_trades),
               text_color=win_rate > 50 ? color.lime : color.red, text_size=size.small)
